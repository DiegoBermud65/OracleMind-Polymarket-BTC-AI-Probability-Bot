# OracleMind — Polymarket BTC AI Probability Bot (5m / 15m / 1h)

# ── Mode ─────────────────────────────────────────────────
LIVE=false
LIVE_CONFIRM=false

# ── Profiles (live | paper | monitor | disabled) ─────────
BTC_5M_STATUS=paper
BTC_15M_STATUS=monitor
BTC_1H_STATUS=monitor
ENABLED_PROFILES=BTC_5M,BTC_15M,BTC_1H

# ── Wallet (required for LIVE=true) ──────────────────────
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=0
RPC_URL=https://polygon-rpc.com

# ── Polymarket APIs ───────────────────────────────────────
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ── Price Feeds ───────────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
CHAINLINK_BTC_USD_FEED=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
# CHAINLINK_STREAM_URL=https://your-chainlink-data-stream-endpoint

# ── Probability Edge ──────────────────────────────────────
MIN_EDGE=0.02
MIN_EDGE_AFTER_FEES=0.02
MAKER_EDGE_DISCOUNT=0.008
TAKER_EDGE_PREMIUM=0.012
SLIPPAGE_BPS=15
STOP_BUYING_BEFORE_CLOSE_SECONDS=90

# ── Risk Controls ─────────────────────────────────────────
MAX_USD_PER_TRADE=25
MAX_SPEND_PER_MARKET=50
MAX_SPEND_PER_HOUR=200
MAX_SPEND_PER_DAY=500
MAX_TRADES_PER_HOUR=12
MAX_LOSS_PER_HOUR=75
MAX_LOSS_PER_DAY=250
MAX_DRAWDOWN_PCT=15
MAX_INVENTORY_USD=150
MAX_CONSECUTIVE_LOSSES=5
COOLDOWN_AFTER_LOSS_MS=60000
MIN_ORDERBOOK_DEPTH_USD=100
MAX_SPREAD_BPS=350
KILL_SWITCH=false

# ── Runtime ───────────────────────────────────────────────
FEED_STALE_MS=5000
LOOP_INTERVAL_MS=2000
SQLITE_PATH=./data/oraclemind.db
DASHBOARD_PORT=3848
LOG_LEVEL=info
LOG_PRETTY=true

